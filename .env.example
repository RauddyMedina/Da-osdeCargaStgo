# =====================================================================
# Variables específicas de DeclaracionCargaDanosStg
# Las demás (OUTLOOK_*, MS_*, GOOGLE_SHEET_ID) se heredan del .env del padre
#   c:\Users\Usuario\Documents\claude\.env
# =====================================================================

# --- Destinatarios del correo consolidado (separados por coma) ---
DESTINATARIOS_DANOS=skarlett.lucero@cencosud.cl,jonathanfreddy.carvalloflores@easy.cl,diego.hernandezsanhueza@easy.cl,enrique.arcila.ext@transyanez.cl,marion.gonzalez.ext@transyanez.cl,ext_roberto.cofre@transyanez.cl,ext_isamar.riquelme@transyanez.cl,jessicaalejandra.munozcasano@easy.cl,jean.menendez@transyanez.cl,carolina.sanchez@transyanez.cl,Torredecontrol@transyanez.cl,sasha.raventosoliver@easy.cl

# --- Remitente / SMTP ---
REMITENTE_DANOS=ext_rauddy.medina@transyanez.cl
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587

# --- Google Sheet histórico ---
# El GOOGLE_SHEET_ID se hereda del .env del padre
GOOGLE_SHEET_TAB_HISTORICO=HISTORICO_DANOS_ANDEN

# --- Política de fotos ---
MIN_FOTOS_POR_CARGA=1

# --- Carpeta Outlook (opcional override del padre) ---
# OUTLOOK_FOLDER=EasyGo

# =====================================================================
# Variables necesarias para deploy en Render
# =====================================================================

# Password compartido para entrar a la app (cualquier string, mín. 12 chars recomendado)
APP_PASSWORD=cambia-este-password

# Directorio de datos persistentes.
# - En LOCAL: déjalo vacío o quítalo (usa ./data dentro del proyecto).
# - En RENDER: apunta al mount del disco persistente (ej: /var/data).
# DATA_DIR=/var/data
